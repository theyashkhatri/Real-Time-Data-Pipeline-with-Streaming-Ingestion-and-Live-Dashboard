# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=analytics

KAFKA_TOPIC=orders
CONSUMER_GROUP=orders-processor

# Producer behaviour
EVENTS_PER_SECOND=5
INVALID_RATE=0.03
DUPLICATE_RATE=0.01

# Consumer batching
BATCH_SIZE=50
BATCH_TIMEOUT_SECONDS=2
